# Copy to .env (git-ignored) and fill in. Loaded by brain/config.py on start.

# Key for the language model behind Rocky. Which provider it belongs to is
# LLM_BASE_URL: OpenRouter by default (openrouter.ai/keys), or an Anthropic
# or OpenAI key with that provider's URL and model name.
LLM_API_KEY=

# Optional: provider and model, overriding brain/config.py (examples there).
# For an Anthropic key:
#   LLM_BASE_URL=https://api.anthropic.com/v1/
#   MODEL=claude-haiku-5-5
LLM_BASE_URL=
MODEL=
# Optional: per-call token ceiling (default 1024; thinking models need room).
LLM_MAX_TOKENS=

# fish.audio/app/api-keys — Rocky's voice (optional; falls back to Piper if
# installed, else the computer's own voice)
FISH_AUDIO_API_KEY=

# Optional: which voice speaks. auto (empty) = Fish Audio if the key above is
# set, else Piper if installed (pip install -r requirements-piper.txt), else
# the computer's own. Or force one: fish, piper, builtin.
TTS_ENGINE=
# Optional: which Piper voice, from PIPER_VOICES in brain/config.py
# (en_US-ryan-medium when empty; en_US-hfc_male-medium is the other).
PIPER_VOICE=

# What Rocky calls you
HUMAN_NAME=

# Optional: home, for the weather and local web searches ("Portland, OR",
# "Paris, France"). Empty = he asks where. TEMP_UNIT=celsius for Celsius.
HOME_LOCATION=

# Optional: WEB_SEARCH=0 turns off web search. It needs an Anthropic key
# (LLM_BASE_URL above) and costs about 1 cent a question; brain/web.py.


# Optional: rename the robot (wake word "hey <name>"; empty = Rocky), and
# other names it answers to, comma-separated. A name like RockyChan is also
# heard as "Rocky Chan". The character stays Rocky (personality.py).
#   ROBOT_NAME=RockyChan
#   ROBOT_ALIASES=Rocky
ROBOT_NAME=
ROBOT_ALIASES=

# Shared secret the robot must present when it connects (also in firmware/include/secrets.h)
ROBOT_TOKEN=

# Which robot body: desk-robot (the original, firmware/) or stackchan
# (M5Stack StackChan, firmware-stackchan/). Empty means desk-robot.
BODY=

# Optional: which microphone to listen on. "robot" = only the robot's (the
# computer's mic is never opened, and nothing listens until the robot
# connects), "mac" = only this computer's, empty = "auto": the robot's while
# it's connected, else this computer's.
MIC_SOURCE=

# Optional: which computer microphone to use when the robot is offline, by
# name (python -m sounddevice lists them). Leave empty for the system default.
MIC_DEVICE=

# Optional: speech-to-text engine. parakeet (empty, the default: the most
# accurate, ~0.1 s on a modern CPU, a ~660 MB download), whisper (told the
# names to expect; slow on an old CPU), or moonshine (fast, less accurate).
# MOONSHINE_MODEL: base (default) or tiny. DEBUG_STT_COMPARE=1 runs a second
# engine too and prints both transcripts.
STT_ENGINE=
MOONSHINE_MODEL=
DEBUG_STT_COMPARE=
# Optional: CPU threads for speech-to-text (default 8) and for the
# end-of-turn model (default 2). On a 4-core server, 4 and 4.
STT_THREADS=
TURN_THREADS=

# Optional: where the two turn-detection models are cached on first run.
# Default is ~/.cache/desk-robot/ (the speech model goes to ~/.cache/huggingface/).
DESK_ROBOT_CACHE=
